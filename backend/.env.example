# ════════════════════════════════════════
# CircleVid Backend — Environment Variables
# ════════════════════════════════════════
# Copy this file to .env and fill in your values

# ── Server ─────────────────────────────
PORT=4000
NODE_ENV=development

# ── MongoDB ────────────────────────────
# Local:   mongodb://localhost:27017/circlevid
# Atlas:   mongodb+srv://user:password@cluster.mongodb.net/circlevid
MONGODB_URI=mongodb://localhost:27017/circlevid

# ── Storage: Cloudflare R2 ─────────────
# Get these from Cloudflare Dashboard → R2 → Manage API Tokens
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=circlevid-videos
R2_PUBLIC_URL=https://pub-XXXX.r2.dev
# OR: https://videos.yourdomain.com (if using custom domain)

# ── Storage: AWS S3 (alternative) ──────
# Uncomment if using S3 instead of R2
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=eu-central-1
# S3_BUCKET_NAME=circlevid-videos
# S3_PUBLIC_URL=https://circlevid-videos.s3.eu-central-1.amazonaws.com

# ── App Settings ───────────────────────
# Views granted per uploaded video
VIEWS_PER_UPLOAD=5
# Boost views for new videos (shown to everyone first N times)
BOOST_VIEWS=10
# Maximum upload size in MB (frontend also enforces this)
MAX_FILE_SIZE_MB=10
# Min/Max video duration in seconds
MIN_DURATION=5
MAX_DURATION=45
# Auto-hide video below this score
HIDE_SCORE_THRESHOLD=-10

# ── CORS ───────────────────────────────
# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
